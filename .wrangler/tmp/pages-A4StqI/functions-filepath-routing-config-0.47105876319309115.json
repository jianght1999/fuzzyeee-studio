      "module": [
        "api/pages/[category]/[[slug]].ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/pages/:category",
      "mountPath": "/api/pages",
      "method": "GET",
      "module": [
        "api/pages/[category].ts:onRequestGet"
      ]
    },
